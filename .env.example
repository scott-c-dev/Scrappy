# Scrappy server-side keys. Copy to `.env.local` and fill in.
# These are read ONLY inside src/app/api/*/route.ts — never shipped to the client.

# LLM — ingredient parsing, recipe generation, constraint solving.
# Two API formats: "anthropic" (Claude's Messages API) or "openai-chat" (OpenAI's
# Chat Completions, also spoken by most other vendors and local servers).
LLM_API_FORMAT=anthropic
LLM_API_KEY=
# Default: the format's official URL. Set it to use another vendor, e.g.
# https://api.deepseek.com or http://localhost:11434/v1 (Ollama).
# LLM_BASE_URL=
# Default on the official URL: claude-sonnet-5 / gpt-6-luna. Required with LLM_BASE_URL.
# LLM_MODEL=
# Unset = no reasoning params sent: cheapest, and works with any model. Set it to
# low / medium / high to reason more (Anthropic: adaptive thinking + effort;
# openai-chat: reasoning_effort). The gpt-6-luna default already uses low.
# Not every model accepts it; e.g. Claude Haiku 4.5 doesn't support effort.
# LLM_EFFORT=low
# openai-chat only: set to "object" for vendors without json_schema support.
# LLM_JSON_MODE=object

# Deepgram — speech-to-text (a short-lived browser token is minted server-side).
DEEPGRAM_API_KEY=

# Image generation: Midjourney via its MCP server. There is NO API key — auth is
# OAuth, done once with `pnpm midjourney:auth` (tokens persist in .mcp-auth/).
# Override the endpoint only if needed.
# MIDJOURNEY_MCP_URL=https://mcp.midjourney.com/mcp

# Set to 1 to answer the AI routes (ingredients, preference, recipes, images)
# with local fakes instead of the LLM/Midjourney — no credit used. Handy for
# testing the UI flow; restart the dev server after changing it.
# MOCK_AI=1

# Your machine's LAN IP, so the dev server accepts cross-origin HMR requests
# when you open it from another device (e.g. a phone) on the same network.
# DEV_LAN_ORIGIN=10.0.0.175
