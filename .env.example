# Scrappy server-side keys. Copy to `.env.local` and fill in.
# These are read ONLY inside src/app/api/*/route.ts — never shipped to the client.

# LLM — ingredient parsing, recipe generation, constraint solving.
# There's no server key: each person connects their own AI key in the app
# (Settings → AI service). It's kept on their device and sent with each
# request; the server never stores it.
#
# A key for "Custom" services can point anywhere, so private and local
# addresses (192.168.x.x, localhost…) are refused — otherwise a visitor could
# make this server reach machines on its own network. Set this only when you
# run Scrappy on your own network, e.g. to use Ollama on another machine.
# ALLOW_PRIVATE_LLM_URLS=1

# Deepgram — speech-to-text (a short-lived browser token is minted server-side).
DEEPGRAM_API_KEY=

# Image generation: Midjourney via its MCP server. There is NO API key — auth is
# OAuth, done once with `pnpm midjourney:auth` (tokens persist in .mcp-auth/).
# Override the endpoint only if needed.
# MIDJOURNEY_MCP_URL=https://mcp.midjourney.com/mcp

# Set to 1 to answer the AI routes (ingredients, preference, recipes, images)
# with local fakes instead of the LLM/Midjourney — no credit used. Handy for
# testing the UI flow; restart the dev server after changing it. The app still
# asks for a key, and accepts any (a key containing "wrong", "nomodel" or
# "down" fails that way); saying "out of credit" or "key refused" shows those
# messages.
# MOCK_AI=1

# Your machine's LAN IP, so the dev server accepts cross-origin HMR requests
# when you open it from another device (e.g. a phone) on the same network.
# DEV_LAN_ORIGIN=10.0.0.175
